diff --git a/core/typedefs.h b/core/typedefs.h
index ecc13e8..0f13f07 100644
--- a/core/typedefs.h
+++ b/core/typedefs.h
@@ -376,7 +376,11 @@ struct BuildIndexSequence<0, Is...> : IndexSequence<Is...> {};
 // Macro GD_IS_DEFINED() allows to check if a macro is defined. It needs to be defined to anything (say 1) to work.
 #define __GDARG_PLACEHOLDER_1 false,
 #define __gd_take_second_arg(__ignored, val, ...) val
-#define ____gd_is_defined(arg1_or_junk) __gd_take_second_arg(arg1_or_junk true, false)
+// The extra expansion forces the comma produced by __GDARG_PLACEHOLDER_1 to split into
+// separate arguments. MSVC's legacy preprocessor skips that re-scan otherwise, which made
+// GD_IS_DEFINED() always false there (and build profiles silently disable nothing).
+#define __gd_expand(x) x
+#define ____gd_is_defined(arg1_or_junk) __gd_expand(__gd_take_second_arg(arg1_or_junk true, false))
 #define ___gd_is_defined(val) ____gd_is_defined(__GDARG_PLACEHOLDER_##val)
 #define GD_IS_DEFINED(x) ___gd_is_defined(x)
 
