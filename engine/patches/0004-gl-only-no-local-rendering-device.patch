 RenderingDevice *RenderingServer::create_local_rendering_device() const {
+#ifdef RD_ENABLED
 	RenderingDevice *device = RenderingDevice::get_singleton();
 	if (!device) {
 		return nullptr;
 	}
 	return device->create_local_device();
+#else
+	// No RenderingDevice backend is compiled in (GL-only build), so there is never a
+	// global device to spawn from. Returning early lets the linker drop the unused
+	// RenderingDevice implementation, which this call would otherwise keep alive.
+	return nullptr;
+#endif
 }
 
